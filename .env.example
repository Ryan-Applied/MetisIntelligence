# Context Intelligence — local dev environment
# Copy to .env and adjust. NEVER commit a real .env.

# --- Edition ---------------------------------------------------------------
# core  = CI Core (AC dev fleet)
# metis = CI-Metis offensive-security edition (hard-isolated deployment)
CI_EDITION=core

# --- Postgres (+ pgvector) -------------------------------------------------
POSTGRES_USER=ci
POSTGRES_PASSWORD=ci_dev_password_change_me
POSTGRES_DB=context_intelligence
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis -----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MinIO (S3-compatible evidence store) ----------------------------------
MINIO_ROOT_USER=ci_minio
MINIO_ROOT_PASSWORD=ci_minio_dev_password_change_me
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=ci-evidence

# --- Gateway ---------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_LOG_LEVEL=info
